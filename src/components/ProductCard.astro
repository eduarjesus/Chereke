---
import type { Producto } from '../lib/products';

interface Props {
  producto: Producto;
}

const { producto } = Astro.props;
const foto = producto.fotos[0];
---

<a href={`/producto/${producto.slug}/`} class="card" class:list={{ 'card--agotado': !producto.disponible }}>
  {foto && <img src={foto} alt={producto.nombre} loading="lazy" />}
  <div class="card__meta">
    <span class="card__nombre">{producto.nombre}</span>
    <span class="card__precio">{producto.disponible ? `$${producto.precio}` : 'Agotado'}</span>
  </div>
</a>

<style>
  .card {
    display: block;
    text-decoration: none;
    color: inherit;
    break-inside: avoid;
    margin-bottom: 1.75rem;
  }

  .card img {
    width: 100%;
    border-radius: 2px;
    filter: saturate(1);
    transition: filter 0.3s ease, opacity 0.3s ease;
  }

  .card:hover img {
    filter: saturate(1.08);
  }

  .card--agotado img {
    filter: grayscale(0.5);
    opacity: 0.7;
  }

  .card__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-top: 1px solid rgba(64, 48, 31, 0.15);
    margin-top: 0.6rem;
    padding-top: 0.5rem;
    gap: 0.75rem;
  }

  .card__nombre {
    font-family: var(--font-body);
    font-size: 0.95rem;
  }

  .card__precio {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--terracotta);
    white-space: nowrap;
  }

  .card--agotado .card__precio {
    color: rgba(64, 48, 31, 0.5);
    font-style: normal;
    font-family: var(--font-body);
    font-size: 0.85rem;
  }
</style>
